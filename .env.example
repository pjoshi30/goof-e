# Copy this file to .env and fill it in. .env is ignored by git.

# --- API keys ---
# Claude plans and talks (required for the voice app): https://console.anthropic.com
ANTHROPIC_API_KEY=
# Gemini Robotics-ER 2 finds and names objects: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: natural-sounding voice. Without it, the browser's built-in voice is used.
OPENAI_API_KEY=

# --- Hardware ---
# Serial ports of the two arms' driver boards. Find them with `lerobot-find-port`.
GOOFE_FOLLOWER_PORT=/dev/tty.usbmodemXXXXXXXXXXX
GOOFE_LEADER_PORT=/dev/tty.usbmodemYYYYYYYYYYY
# Index of the top-down webcam. Check with `python -m deskbot.snap 0` (try 1, 2… if wrong).
GOOFE_CAMERA_INDEX=0
